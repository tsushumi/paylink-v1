    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "nodemailer": "^10.1.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  },
  "overrides": {
