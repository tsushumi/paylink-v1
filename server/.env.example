PORT=3000
DATABASE_URL="postgresql://paylink:paylink@localhost:5432/paylink?schema=public"

# Daraja (sandbox) credentials from developer.safaricom.co.ke
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_ENV=sandbox
# Your public ngrok URL + /api/mpesa/callback
MPESA_CALLBACK_URL=https://your-subdomain.ngrok-free.app/api/mpesa/callback

# Base URL of the React app (used in QR codes and emails)
APP_URL=http://localhost:5173

# Set MPESA_MOCK=true to run without Daraja (fake STK push, use the simulator)
MPESA_MOCK=false

# Optional: payment confirmation emails (Gmail app password)
EMAIL_USER=
EMAIL_APP_PASSWORD=
# Where payment emails go when a link has no notification email of its own (defaults to EMAIL_USER)
NOTIFY_EMAIL=

# Optional: shared secret. If set, the callback URL sent to Safaricom gets ?token=<secret>
# and callbacks without it are rejected with 403.
MPESA_CALLBACK_SECRET=
